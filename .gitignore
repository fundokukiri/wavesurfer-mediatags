# Dependencies (none required, kept for safety if tooling is added later)
node_modules/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# FUSE/ntfs-3g leftovers: files that were replaced while still open get
# renamed here by libfuse. They cannot be unlinked through the mount and
# vanish when the volume is remounted.
.fuse_hidden*

# Logs
*.log
npm-debug.log*

# Local tool settings
.claude/
.zcode/

# Code intelligence indexes (codegraph / graphify)
.codegraph/
graphify-out/

# Music and its generated playlist stay local — the tracks are not ours to
# redistribute, so they never enter the repo.
audio/*.mp3

# Scratch files from debugging: never part of the app.
test/_*.mjs
shots/
/images/
*.bak
*.orig
*.rej
*.tmp
*.bundle

# Editor and tooling leftovers
.vscode/
.idea/
playwright-report/
test-results/
.playwright/

# A stray copy of the vendored player must not shadow js/wavesurfer-7.min.js.
/wavesurfer-7.min.js
